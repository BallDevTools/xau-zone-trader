# Price feed: metaapi (cloud) | mt5 (local MT5 terminal on Windows, shadow only)
FEED=metaapi
# mt5 feed only — optional: python with `pip install MetaTrader5`, terminal64.exe when several are installed
MT5_PYTHON=
MT5_PATH=

# MetaAPI (https://app.metaapi.cloud) — create a token with only the scopes you need
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard (binds to localhost only)
DASHBOARD_PORT=3000
